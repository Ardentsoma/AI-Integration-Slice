# --- Database -------------------------------------------------------------
# Local PostgreSQL connection string for the app role.
# Matches docker-compose.yml if you use the bundled container, or your own
# local Postgres. Example below uses role `scope` with database `scope`.
DATABASE_URL="postgresql://scope:scope_secret@localhost:5432/scope"

# --- Auth -----------------------------------------------------------------
# Secret used to sign the session cookie (HMAC-SHA-256). Generate a strong
# random value, e.g. `openssl rand -hex 32`. Keep it stable across restarts.
AUTH_SECRET="replace-with-a-long-random-string"

# --- Email (SMTP) ---------------------------------------------------------
# For Gmail: host smtp.gmail.com, port 465, SMTP_USER = your Gmail address,
# SMTP_PASS = a 16-character App Password (Google Account > Security > App
# passwords; 2-Step Verification must be on). EMAIL_FROM must be the same
# address (or an identity verified with the provider).
#
# Leave SMTP_USER/SMTP_PASS blank to run in development mode, where emails are
# printed to the server console with an "[email:dev]" prefix instead of being
# sent. Use `npm run email:test` to probe the connection before testing an
# OTP flow.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="SCOPE <you@gmail.com>"
# Set to "false" if your provider uses a self-signed certificate (rare).
# Set to "true" to keep a persistent connection pool for bulk resend runs.
SMTP_REJECT_UNAUTHORIZED="true"
SMTP_POOL="false"

# --- AI (Gemini extraction + DeepSeek follow-up) --------------------------
# Gemini key from Google AI Studio (https://aistudio.google.com/apikey).
# Used by the extraction role to turn a raw client brief into a structured
# outline. Leave blank only if you want the brief flow to fail fast with an
# honest error instead of running.
GEMINI_API_KEY=""
# DeepSeek API key from https://platform.deepseek.com. The follow-up action
# role (e.g. "expand this brief") runs on DeepSeek's OpenAI-compatible API.
DEEPSEEK_API_KEY=""

# --- Cloudflare R2 (brief file storage) --------------------------------------
# R2 account id, found in the Cloudflare dashboard under R2 > Overview.
# Combined with the S3-compatible endpoint to reach your bucket.
R2_ACCOUNT_ID=""
# R2 access key id. Create an R2 API token under R2 > Manage R2 API Tokens.
R2_ACCESS_KEY_ID=""
# R2 secret access key for that API token (shown only once at creation).
R2_SECRET_ACCESS_KEY=""
# Bucket name that uploaded briefs are stored in. Must already exist in R2.
R2_BUCKET_NAME=""
# Optional: override the S3 endpoint. Only needed to point the client at
# local/self-hosted S3-compatible storage (tests, demos). Defaults to
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com.
R2_ENDPOINT=""